// Verbatim copy of the ACTUAL, CURRENTLY DEPLOYED production firestore.rules (repo root,
// read directly, not the unapplied canonical Photo Library architecture ruleset in
// firestore.rules alongside this file, which was never deployed and has its own
// separately-documented, separately-tracked defects irrelevant to this MVP). This file
// exists so the owner-only Photo Library MVP — which this session's own plan states
// requires ZERO rule changes — can be verified against what is really live today, not
// against a different, hypothetical ruleset.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Personal data — only accessible by the owner
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Shared co-authoring journals — any signed-in user can read/write
    match /journals/{journalId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    // Public share snapshots — anyone can read, only owner can write
    match /public_notebooks/{notebookId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
